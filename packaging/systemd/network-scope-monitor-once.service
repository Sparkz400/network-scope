# One monitor cycle per run, started by network-scope-monitor-once.timer: the alternative to the
# always-running network-scope-monitor.service when a scan every N minutes is enough.
# `--cycles 1` runs one scan, compares it with the previous one in the inventory, raises alerts and
# exits; a persisting alert is not repeated because the alert history is read from the inventory.

[Unit]
Description=Network Scope monitor (one cycle)
Documentation=https://sparkz400.github.io/network-scope/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/network-scope-cli monitor 192.168.1.0/24 --cycles 1 --db /var/lib/network-scope/inventory.sqlite --alerts /var/lib/network-scope/alerts.jsonl
TimeoutStartSec=1h

DynamicUser=yes
StateDirectory=network-scope
StateDirectoryMode=0750
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Raw features: see the comment at the end of network-scope-monitor.service.

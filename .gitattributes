# Shell scripts run in Linux containers (ClusterFuzzLite build).
*.sh text eol=lf
# Fuzz seeds are raw bytes: never convert line endings.
fuzz/corpus/** -text
# Capture files (test fixtures and fuzz seeds) are binary.
*.pcap binary
*.pcapng binary
# Package-manager templates (packaging/): makepkg and Homebrew expect LF.
packaging/aur/** text eol=lf
packaging/homebrew/** text eol=lf
# Git hooks (.githooks/) are run by sh, also on Windows: LF only.
.githooks/* text eol=lf

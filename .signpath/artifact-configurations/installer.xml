<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer" (paste it into the SignPath project).
     The GitHub artifact uploaded by release.yml ("unsigned-windows-installer") is a ZIP with the
     Inno Setup installer at its root; it gets an Authenticode signature. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="NetworkScope-*-setup.exe" max-matches="1" product-name="Network Scope">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>

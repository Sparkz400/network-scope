# Build context for the Dockerfile: only src/, core/ (the engine crate), data/ and
# scripts/library/ (both embedded with include_str!), assets/icon/icon-256.png (the window icon,
# include_bytes! in src/gui), tests/fixtures (used by tests only), build.rs, the Cargo files and
# rust-toolchain.toml are needed.
.git
.github
.devcontainer
.claude
target/
fuzz/target/
dist/
docs/
assets/
installer/
lab/
scripts/
**/*.gif
**/*.png
**/*.pcap
**/*.pcapng
*.sqlite
Dockerfile
.dockerignore

# ClusterFuzzLite builds .clusterfuzzlite/Dockerfile from this same context and needs the
# seed corpora (including .pcap/.pcapng files); later rules win, so keep them.
!fuzz/corpus/**

# The shared Rhai script library is compiled into the binary (core/src/script.rs).
!scripts/library/**

# The window icon is compiled into the GUI code (src/gui/mod.rs), which the default features build.
!assets/icon/icon-256.png

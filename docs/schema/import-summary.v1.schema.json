{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:network-scope:import-summary:v1",
  "title": "Import summary",
  "description": "Output of import KIND FILE --format json: what was merged into the inventory (no scan is saved).",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "merged",
    "skipped",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "network-scope/import-summary/v1"
    },
    "kind": {
      "type": "string",
      "description": "The import kind, for example csv, isc-dhcp or netbox"
    },
    "merged": {
      "type": "object",
      "required": [
        "devices",
        "new",
        "known",
        "skipped"
      ],
      "properties": {
        "devices": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "known": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "description": "Entries the parser skipped"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

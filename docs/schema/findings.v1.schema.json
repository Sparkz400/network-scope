{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:network-scope:findings:v1",
  "title": "Findings",
  "description": "Output of `findings ID`: weak TLS/SSH, risky services and CVE hints of one scan.",
  "$defs": {
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "finding": {
      "type": "object",
      "required": [
        "severity",
        "id",
        "title",
        "ip",
        "port",
        "evidence",
        "cve",
        "advice"
      ],
      "properties": {
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "ip": {
          "type": "string",
          "description": "IPv4 or IPv6 address in text form"
        },
        "port": {
          "type": [
            "integer",
            "null"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "cve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advice": {
          "type": "string"
        },
        "reference": {
          "type": "string",
          "description": "HTTPS URL of the documentation page, when the rule has one"
        },
        "kev": {
          "type": "boolean",
          "description": "Present only with imported feeds"
        },
        "vex": {
          "type": "object",
          "description": "Present only when an imported VEX statement (feeds import vex) covers the finding's CVE for the product and version the scan saw",
          "required": [
            "state",
            "source"
          ],
          "properties": {
            "state": {
              "enum": [
                "not_affected",
                "fixed",
                "false_positive",
                "affected",
                "under_investigation"
              ]
            },
            "justification": {
              "type": "string",
              "description": "CSAF flag label or CycloneDX justification"
            },
            "detail": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "description": "CSAF tracking id or CycloneDX serial number of the statement"
            }
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "schema",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "network-scope/findings/v1"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Only from the MCP server: the number of matches before the limit was applied"
    },
    "truncated": {
      "type": "boolean",
      "description": "Only from the MCP server: true when the list was cut at the limit"
    }
  }
}
